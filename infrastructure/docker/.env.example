# PLACEHOLDERS ONLY — never put real secrets in this file or in git.
# Copy to .env (git-ignored) for local development.
# Variable names below match what the code actually reads (Phase 17).
NODE_ENV=development
PORT=3001

# Postgres (PostGIS) — required in staging/production.
DATABASE_URL=postgres://rahi:change-me-dev-only@localhost:5432/rahi
POSTGRES_USER=rahi
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=rahi

# Redis — required for shared OTP limiting, GEO index and the
# Socket.IO adapter. Without it the API uses in-memory fallbacks
# (single instance only) and logs DEV ONLY warnings.
REDIS_URL=redis://localhost:6379

# Auth — required in production (no usable default).
JWT_SECRET=change-me
# Encryption at rest for MFA secrets + bank accounts (32 bytes,
# 64 hex chars or base64). Production refuses to boot without it.
ENCRYPTION_KEY=

# Routing — haversine (default) or osrm. With osrm, point
# OSRM_BASE_URL at YOUR OWN instance; without it the public OSRM
# demo server is used and a warning is logged (dev only).
MAPS_PROVIDER=osrm
OSRM_BASE_URL=http://localhost:5000

# Documents — S3-compatible bucket (AWS S3 or MinIO). Without
# S3_BUCKET the API uses local disk (dev only). MinIO needs
# S3_ENDPOINT + path-style addressing (automatic when an
# endpoint is set, or force with S3_FORCE_PATH_STYLE=true).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rahi-dev
S3_ACCESS_KEY_ID=rahi-dev
S3_SECRET_ACCESS_KEY=change-me-dev-only-minio
S3_FORCE_PATH_STYLE=true

# SMS — log (dev default) or twilio (real delivery). With twilio,
# all three TWILIO_* vars are required or the API refuses to boot.
# See docs/SMS-DELIVERY.md. Never commit real values.
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_BRAND_NAME=Rahi

# Socket CORS — comma-separated browser origins, or unset for the
# local admin web default (http://localhost:3000). '*' is ignored.
SOCKET_CORS_ORIGINS=http://localhost:3000

# Driver documents on local disk (only when S3_BUCKET is unset).
STORAGE_DIR=./uploads

# MinIO console (compose storage profile).
MINIO_ROOT_USER=rahi-dev
MINIO_ROOT_PASSWORD=change-me-dev-only-minio
